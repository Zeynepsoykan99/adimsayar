{
  "//minSdk": "minSdkVersion 28 (Android 9) bilinçli bir karardır: Health Connect uygulaması yalnızca Android 9 ve üstünde çalışır. androidx.health.connect SDK'sı teknik olarak API 26'dan itibaren derlenebiliyor ama API 26-27 cihazlarda Health Connect hiç kullanılamadığı için eşik 28'e çekildi.",
  "expo": {
    "name": "adimsayar",
    "slug": "adimsayar",
    "scheme": "adimsayar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zeynep.adimsayar"
    },
    "android": {
      "package": "com.zeynep.adimsayar",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.health.READ_STEPS"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "react-native-health-connect",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/app-check",
      [
        "expo-sensors",
        {
          "motionPermission": "Adım sayınızı gösterebilmek için hareket ve fitness verinize erişim gerekiyor."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
